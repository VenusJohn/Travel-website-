<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dream Travel Website</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#f4f7fb;
    overflow-x:hidden;
}

/* NAVBAR */

.navbar{
    background:rgba(0,0,0,0.5);
    backdrop-filter:blur(8px);
    padding:15px 40px;
}

.navbar-brand{
    color:white !important;
    font-size:30px;
    font-weight:700;
}

.nav-link{
    color:white !important;
    margin-left:20px;
    transition:0.3s;
}

.nav-link:hover{
    color:#00d4ff !important;
}

/* HERO SECTION */

.hero{
    height:100vh;
    background:
    linear-gradient(rgba(0,0,0,0.5),rgba(0,0,0,0.5)),
    url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e');
    background-size:cover;
    background-position:center;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:white;
}

.hero h1{
    font-size:75px;
    font-weight:700;
    animation:slide 1.5s ease;
}

.hero p{
    width:70%;
    margin:auto;
    margin-top:20px;
    font-size:20px;
}

.explore-btn{
    margin-top:30px;
    padding:14px 35px;
    border:none;
    border-radius:40px;
    background:#00bcd4;
    color:white;
    font-size:18px;
    transition:0.4s;
}

.explore-btn:hover{
    background:#0097a7;
    transform:scale(1.08);
}

/* ANIMATION */

@keyframes slide{
    from{
        opacity:0;
        transform:translateY(-50px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* DESTINATIONS */

.section-title{
    text-align:center;
    margin-top:80px;
    margin-bottom:50px;
    font-size:45px;
    font-weight:700;
    color:#222;
}

.destination-card{
    border:none;
    overflow:hidden;
    border-radius:25px;
    transition:0.5s;
    box-shadow:0 10px 25px rgba(0,0,0,0.1);
}

.destination-card:hover{
    transform:translateY(-12px);
}

.destination-card img{
    height:280px;
    object-fit:cover;
}

.price{
    color:#00bcd4;
    font-size:22px;
    font-weight:700;
}

/* GALLERY */

.gallery{
    margin-top:100px;
    padding:80px 0;
    background:#0f172a;
}

.gallery img{
    width:100%;
    height:250px;
    object-fit:cover;
    border-radius:20px;
    transition:0.4s;
}

.gallery img:hover{
    transform:scale(1.05);
}

/* CONTACT */

.contact{
    padding:100px 0;
    background:white;
}

.contact-box{
    padding:40px;
    border-radius:25px;
    box-shadow:0 10px 40px rgba(0,0,0,0.1);
}

.contact img{
    width:100%;
    border-radius:20px;
}

.contact-title{
    color:#ff7a00;
    font-size:50px;
    font-weight:700;
}

.phone-box{
    display:flex;
    align-items:center;
    margin-top:40px;
}

.phone-icon{
    width:80px;
    height:80px;
    border-radius:50%;
    background:#ff7a00;
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:35px;
}

/* FOOTER */

footer{
    background:#081018;
    color:white;
    text-align:center;
    padding:25px;
}

/* RESPONSIVE */

@media(max-width:768px){

    .hero h1{
        font-size:45px;
    }

    .hero p{
        width:90%;
        font-size:16px;
    }

    .contact-title{
        font-size:35px;
    }

}

</style>
html{
    scroll-behavior:smooth;
}
body{
    background:#f4f7fb;
    overflow-x:hidden;
}

html{
    scroll-behavior:smooth;
}

</head>
<body>

